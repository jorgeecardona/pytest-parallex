#!/usr/bin/env bash
# pytest-parallex pre-push -- mirror CI's `test` stage so failures are caught locally
# before the push round-trip: ruff + pyright + pytest (see `make check`).
# Activated via `make install-hooks`. Bypass with `git push --no-verify`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec make check
