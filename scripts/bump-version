#!/bin/sh
# Bump the project version in pyproject.toml -- the single source of truth that
# hatchling builds from and that the release tag must match.
#
# Usage: ./scripts/bump-version [patch|minor|major]   (default: patch)
#
# Called automatically by the pre-commit hook when src/ changes; also runnable
# by hand (or `make bump TYPE=minor`) for an intentional minor/major release.

set -e
cd "$(dirname "$0")/.."

BUMP_TYPE="${1:-patch}"

CURRENT=$(grep -E '^version = "' pyproject.toml | head -1 | sed -E 's/^version = "(.*)"/\1/')
if [ -z "$CURRENT" ]; then
    echo "bump-version: could not read 'version = \"...\"' from pyproject.toml" >&2
    exit 1
fi

MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
PATCH=$(echo "$CURRENT" | cut -d. -f3)

case "$BUMP_TYPE" in
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    patch) PATCH=$((PATCH + 1)) ;;
    *)
        echo "Usage: $0 [patch|minor|major]" >&2
        exit 1
        ;;
esac

NEW="${MAJOR}.${MINOR}.${PATCH}"

# No `sed -i`: BSD sed reads the flag after -i as the backup suffix, so `-i -E`
# litters `<file>-E` backups on macOS. A temp file behaves the same everywhere.
replace() {
    sed -E "s/^$2 = \"${CURRENT}\"/$2 = \"${NEW}\"/" "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}
replace pyproject.toml version
# __version__ in the package mirrors pyproject (testing/test_plugin.py asserts they match).
replace src/pytest_parallex/__init__.py __version__

# Keep uv.lock's pinned pytest-parallex version in sync so the working tree stays clean
# (offline + cached = fast; online fallback for a cold cache).
if command -v uv >/dev/null 2>&1; then
    uv lock --offline >/dev/null 2>&1 || uv lock >/dev/null 2>&1 || true
fi

echo "bump-version: ${CURRENT} -> ${NEW}"
